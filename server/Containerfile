FROM docker.io/library/rust:1.98-slim-trixie AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p bukospeak-server \
    && cp target/release/bukospeak-server /bukospeak-server

FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=build /bukospeak-server /usr/local/bin/bukospeak-server
ENV BUKOSPEAK_DATA=/data
VOLUME /data
EXPOSE 9988/udp
ENTRYPOINT ["/usr/local/bin/bukospeak-server"]
